/*
  Content-Security-Policy: base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: browsing-topics=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Unhashed names, so no `immutable`: a revisit uses the cached copy at once and picks up a new build on the next visit.
/markdown-sources.json
  Cache-Control: public, max-age=0, stale-while-revalidate=2592000

/monaco/*
  Cache-Control: public, max-age=0, stale-while-revalidate=2592000

/playground-api.json
  Cache-Control: public, max-age=0, stale-while-revalidate=2592000

/prism.min.js
  Cache-Control: public, max-age=0, stale-while-revalidate=2592000

/view-transitions.css
  Cache-Control: public, max-age=0, stale-while-revalidate=2592000

# A font file never changes in place: a new version of a font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
